{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pchemguy.github.io/tetris-save.schema.json",
  "title": "Tetris snapshot version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "results",
    "settings"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 1
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ghost",
        "hardDrop",
        "nextPreview",
        "hardDropLock",
        "lockPolicy",
        "hold"
      ],
      "properties": {
        "ghost": {
          "enum": [
            "hidden",
            "dynamic",
            "visible"
          ]
        },
        "hardDrop": {
          "type": "boolean"
        },
        "nextPreview": {
          "type": "boolean"
        },
        "hardDropLock": {
          "enum": [
            "general",
            "immediate"
          ]
        },
        "lockPolicy": {
          "enum": [
            "failed",
            "interval"
          ]
        },
        "hold": {
          "type": "boolean"
        }
      }
    },
    "results": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "score",
          "timestamp"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "timestamp": {
            "type": "string",
            "minLength": 24,
            "maxLength": 24,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
            "format": "date-time"
          }
        }
      }
    }
  }
}
